# 이 파일을 `.env`로 복사한 뒤 값을 채우세요. (`.env`는 깃에 커밋되지 않습니다)

# 필수: 디스코드 봇 토큰
# https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# 선택: PUBG API 토큰 (없으면 /점수 등 밸런서 기능만 비활성화됩니다)
# https://developer.pubg.com/ → Apps → Create App
PUBG_TOKEN=

# 선택: 무료 배포 알림을 올릴 채널 ID (없으면 무료 배포 코그만 비활성화됩니다)
# 디스코드 설정 → 고급 → 개발자 모드를 켠 뒤, 채널 우클릭 → "채널 ID 복사"
KS_BOT_GIVEAWAY_CHANNEL_ID=

# --- 아래는 모두 선택 항목이며, 기본값이 적용됩니다 ---
# PUBG_PLATFORM=steam
# KS_BOT_COMMAND_PREFIX=/
# KS_BOT_DB_PATH=res/history.db
# KS_BOT_GAME_RESULT_DIR=res/game_result
# KS_BOT_LOG_LEVEL=INFO
# KS_BOT_MEMBER_STATUS_INTERVAL_MINUTES=30
# KS_BOT_MAX_MATCH_NUM=40
# KS_BOT_PLAYER_CACHE_TTL_HOURS=1
# KS_BOT_GIVEAWAY_INTERVAL_MINUTES=30
# KS_BOT_GIVEAWAY_MENTION_ROLE_ID=
# KS_BOT_GIVEAWAY_INCLUDE_UPCOMING=true
#
# 알림을 받을 스토어 목록(쉼표로 구분). 지정하지 않으면 steam,epic,gog 가 적용됩니다.
# 선택 가능한 값: steam, epic, gog, itch, ubisoft, amazon, origin, microsoft, other
#   steam     Steam
#   epic      Epic Games
#   gog       GOG
#   itch      itch.io       — 소규모 인디 무료 배포가 많아 알림이 묻히기 쉽습니다
#   ubisoft   Ubisoft
#   amazon    Prime Gaming
#   origin    EA
#   microsoft Microsoft / Xbox
#   other     위에 해당하지 않는 스토어
# 전부 받으려면:
# KS_BOT_GIVEAWAY_STORES=steam,epic,gog,itch,ubisoft,amazon,origin,microsoft,other
# KS_BOT_GIVEAWAY_STORES=steam,epic,gog
