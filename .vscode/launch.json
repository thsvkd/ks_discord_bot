{
  // https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: 현재 파일",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "봇 실행 (python -m ks_bot)",
      "type": "debugpy",
      "request": "launch",
      "module": "ks_bot",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "전체 테스트",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "현재 테스트 파일",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "디스코드 메시지 전송 점검",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/send_message.py",
      "args": ["--channel-id", "${input:channelId}", "--message", "KS Bot 연결 테스트 ✅"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "channelId",
      "type": "promptString",
      "description": "메시지를 보낼 디스코드 채널 ID"
    }
  ]
}
